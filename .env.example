# Database Connection
# Supabase PostgreSQL database URL: replace [YOUR_SUPABASE_DB_PASSWORD] with your actual database password
DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_DB_PASSWORD]@db.ulfagbfktqshocbwxfwt.supabase.co:5432/postgres

# Backend Security
# Change this secret key in production!
JWT_SECRET_KEY=portinity-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase API Configuration
SUPABASE_URL=https://ulfagbfktqshocbwxfwt.supabase.co
SUPABASE_KEY=sb_publishable_9RVQyj2Wb75Gpak2OkZYug_5Ez_mhLK

# LLM & RAG Configuration (OpenRouter & NVIDIA Models)
# Replace with your actual OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
